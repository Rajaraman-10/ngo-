SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

USE_MYSQL=false
DB_NAME=ngo_transparency
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay (leave blank to keep the Donate page in its honest "not configured yet" state)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email — console backend prints to the runserver log until real SMTP is configured
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@asha-foundation.example
ORG_CONTACT_EMAIL=contact@asha-foundation.example
