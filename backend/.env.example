SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

USE_MYSQL=false
DB_NAME=ngo_transparency
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Real email delivery via Gmail SMTP. Leave EMAIL_BACKEND unset (or set to the
# console backend) to keep printing emails to the terminal instead of sending them.
# EMAIL_HOST_USER is the full Gmail address; EMAIL_HOST_PASSWORD is a 16-character
# Gmail "App Password" (Google Account -> Security -> 2-Step Verification -> App
# Passwords), NOT the normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-org-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-org-account@gmail.com
ORG_CONTACT_EMAIL=your-org-account@gmail.com

FRONTEND_BASE_URL=http://localhost:5173
